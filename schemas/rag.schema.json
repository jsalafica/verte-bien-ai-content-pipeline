{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contexto RAG",
  "type": "object",
  "properties": {
    "contexto_rag": {
      "type": "string"
    },
    "fuentes_rag": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "prioridad": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "tema",
          "categoria",
          "prioridad"
        ]
      }
    },
    "cantidad_fuentes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "contexto_rag",
    "fuentes_rag",
    "cantidad_fuentes"
  ]
}